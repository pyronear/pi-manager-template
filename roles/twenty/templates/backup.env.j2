BACKUP_PASSPHRASE='{{ twenty_backup_passphrase }}'
S3_ENDPOINT_URL={{ twenty_s3_endpoint_url }}
S3_REGION={{ twenty_s3_region }}
S3_BUCKET={{ twenty_s3_bucket }}
export AWS_ACCESS_KEY_ID={{ twenty_s3_access_key }}
export AWS_SECRET_ACCESS_KEY='{{ twenty_s3_secret_key }}'
# OVH rejects the integrity checksum headers recent aws-cli versions send by default
export AWS_REQUEST_CHECKSUM_CALCULATION=when_required
export AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
