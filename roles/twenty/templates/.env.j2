PG_DATABASE_PASSWORD={{ twenty_pg_password }}
PG_DATABASE_URL=postgres://postgres:{{ twenty_pg_password }}@db:5432/default
REDIS_URL=redis://redis:6379
SERVER_URL=https://{{ twenty_host }}
ENCRYPTION_KEY={{ twenty_encryption_key }}
APP_SECRET={{ twenty_app_secret }}
STORAGE_TYPE=local
# Internal tool with a handful of users: lift the API rate limits (scripts, imports)
API_RATE_LIMITING_LIMIT=1000000
API_RATE_LIMITING_SHORT_LIMIT=1000000
API_RATE_LIMITING_LONG_LIMIT=1000000
{% if twenty_google_client_id %}
AUTH_GOOGLE_ENABLED=true
AUTH_GOOGLE_CLIENT_ID={{ twenty_google_client_id }}
AUTH_GOOGLE_CLIENT_SECRET={{ twenty_google_client_secret }}
AUTH_GOOGLE_CALLBACK_URL=https://{{ twenty_host }}/auth/google/redirect
AUTH_GOOGLE_APIS_CALLBACK_URL=https://{{ twenty_host }}/auth/google-apis/get-access-token
MESSAGING_PROVIDER_GMAIL_ENABLED=true
CALENDAR_PROVIDER_GOOGLE_ENABLED=true
{% endif %}
{% if twenty_smtp_user %}
EMAIL_DRIVER=SMTP
EMAIL_SMTP_HOST={{ twenty_smtp_host }}
EMAIL_SMTP_PORT={{ twenty_smtp_port }}
EMAIL_SMTP_USER={{ twenty_smtp_user }}
EMAIL_SMTP_PASSWORD={{ twenty_smtp_password }}
EMAIL_FROM_ADDRESS={{ twenty_email_from_address }}
EMAIL_FROM_NAME={{ twenty_email_from_name }}
{% endif %}
